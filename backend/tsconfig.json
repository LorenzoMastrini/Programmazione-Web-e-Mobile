{
    "compilerOptions": {
        "module": "CommonJS",
        "moduleResolution": "node",
        "strict": true,
        "outDir": "./build", //built javascript sarà memorizzato qua (backend/built)
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "esModuleInterop": true
    },
    "include": ["src/**/*"], //tutti i file typescript nella cartella src sono selezionati per diventare javascript 
}